# Runtime
APP_ENV=development
# local_rag: local retrieval only; local_llm: local retrieval + local Ollama; cloud: local retrieval + Aliyun chat model
AI_MODE=local_rag
APP_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
SESSION_HOURS=12
ALLOW_REGISTRATION=true
MAX_UPLOAD_BYTES=20971520

# Windows 11 local OCR. Scanned pages are rendered and recognized on this computer only.
LOCAL_OCR_ENABLED=true
OCR_LANGUAGE=zh-Hans-CN
OCR_DPI=200
OCR_MAX_PAGES=500
PDFTOPPM_PATH=

# Completely local Embedding. The first model download may use the network; inference never does.
LOCAL_EMBEDDING_PROVIDER=bge_m3
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
LOCAL_EMBEDDING_MODEL_DIR=
LOCAL_EMBEDDING_ALLOW_DOWNLOAD=true
LOCAL_EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=8
# In local_rag mode, return deterministic review results first and finish the
# uploaded document's full BGE-M3 index in the background.
FAST_REVIEW_BACKGROUND_EMBEDDING=true

# Optional completely local LLM through an OpenAI-compatible loopback endpoint (for example Ollama).
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=
LOCAL_LLM_CHAT_PATH=/chat/completions

# Aliyun chat-model configuration. The key may be a personal test key or a
# company deployment key; Embedding never calls Aliyun. Server-side only.
ALIYUN_API_KEY=
COMPANY_AI_API_KEY_SOURCE=personal
ALIYUN_BASE_URL=
ALIYUN_MODEL=
ALIYUN_CHAT_PATH=/chat/completions
AI_REQUEST_TIMEOUT_SECONDS=60

# Data and vector storage. FAISS files and metadata stay under web/runtime by default.
DATABASE_URL=
VECTOR_DB_URL=
VECTOR_BACKEND=faiss
FAISS_INDEX_ROOT=
RETRIEVAL_MODE=semantic
SQLITE_DATABASE_PATH=
UPLOAD_ROOT=
KNOWLEDGE_ROOT=

# Cost estimate only; replace with the selected model's current company price.
AI_INPUT_COST_PER_MILLION=2
AI_OUTPUT_COST_PER_MILLION=8
